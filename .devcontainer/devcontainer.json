{
  "name": "qvdr",
  "build": {
    "dockerfile": "Dockerfile",
    // context is the repo root so COPY/ADD instructions can reach project files
    "context": ".."
  },

  // rocker/verse uses "rstudio" (UID 1000) as the non-root developer account
  "remoteUser": "rstudio",

  // Persistent named volume keeps Claude authentication tokens across
  // container rebuilds.  Scoped to this project via the "qvdr-" prefix.
  "mounts": [
    {
      "source": "qvdr-claude-auth",
      "target": "/home/rstudio/.claude",
      "type": "volume"
    }
  ],

  "features": {
    // Claude Code CLI — installs the `claude` binary and supporting tooling
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // R language support and integrated debugger
        "REditorSupport.r",
        "REditorSupport.r-debugger"
      ],
      "settings": {
        // Point the R extension at the interpreter inside the container
        "r.rpath.linux": "/usr/local/bin/R",
        "r.rterm.linux": "/usr/local/bin/R"
      }
    }
  },

  // Expose the RStudio Server port in case it is started manually inside
  // the container (not required for VS Code / Claude Code workflows)
  "forwardPorts": [8787],

  "postCreateCommand": "R CMD INSTALL --no-multiarch --with-keep.source ."
}
